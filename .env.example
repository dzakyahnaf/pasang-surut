# Salin berkas ini menjadi .env, lalu isi nilainya. Berkas .env tidak pernah
# masuk git — lihat .gitignore.

# ── Database ───────────────────────────────────────────────────────────
# Koneksi PostgreSQL + PostGIS (Supabase).
#
# WAJIB memakai CONNECTION POOLER, bukan koneksi langsung. Ambil dari
# Supabase > Connect > Transaction pooler. Host-nya berakhiran
# pooler.supabase.com dan portnya 6543.
#
# Kenapa bukan koneksi langsung port 5432: Supabase menyajikannya lewat IPv6,
# sementara Render, Railway, dan banyak jaringan rumah masih IPv4-saja. Ia
# akan jalan di laptop lalu gagal di server, dan pesan galatnya menyesatkan.
#
# KATA SANDI WAJIB DI-PERSEN-ENCODE bila memuat karakter khusus:
#   @ -> %40    : -> %3A    / -> %2F    ? -> %3F    # -> %23    % -> %25
# Tanpa itu pengurai URL memotong di tempat yang salah dan psycopg2 mengira
# host-nya socket lokal. Jalankan `python -m scripts.13_periksa_database`
# dari backend/ untuk memeriksanya tanpa mencetak kata sandinya.
DATABASE_URL=postgresql://postgres.[REF-PROYEK]:[SANDI]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ── CORS ───────────────────────────────────────────────────────────────
# Alamat frontend produksi, dipisah koma tanpa garis miring di ujung.
# Alamat pengembangan localhost:5173 selalu diizinkan tanpa perlu ditulis.
ASAL_DIIZINKAN=https://pasang-surut.vercel.app

# Pola asal tambahan, dipakai untuk subdomain pratinjau Vercel yang berubah
# tiap penerapan. Kosongkan kalau tidak perlu.
ASAL_POLA=^https://.*\.vercel\.app$
