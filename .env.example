# Salin berkas ini menjadi .env, lalu isi nilainya. Berkas .env tidak pernah
# masuk git — lihat .gitignore.

# Koneksi PostgreSQL + PostGIS (Supabase).
# Ambil dari Supabase → Project Settings → Database → Connection string → URI.
# Ganti [PASSWORD] dengan kata sandi database, bukan kata sandi akun Supabase.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF-PROYEK].supabase.co:5432/postgres
