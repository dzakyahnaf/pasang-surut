# ── Rahasia ────────────────────────────────────────────────────────────
# Aturan repo: tidak ada secret yang masuk git. Yang di-commit hanya
# .env.example yang berisi nama variabel tanpa nilainya.
.env
.env.local
.env.*.local

# ── Data mentah ────────────────────────────────────────────────────────
# data/raw/ menampung DEMNAS, ekstrak OSM, dan citra unduhan. Ukurannya
# ratusan MB sampai beberapa GB, jadi tidak pernah masuk repo.
# Foldernya sendiri tetap ada di git lewat .gitkeep supaya struktur utuh
# saat orang lain melakukan git clone.
data/raw/*
!data/raw/.gitkeep

# Raster dan ekstrak peta, di mana pun letaknya
*.tif
*.tiff
*.tfw
*.osm.pbf
*.osm.bz2

# Graf jalan hasil unduhan OSMnx. Tidak di-commit karena besarnya 18 MB dan
# skrip 01 membangunnya ulang dalam belasan detik. Yang DI-COMMIT adalah
# data/processed/ruas_jalan.geojson, supaya peta tetap bisa dibuka pada
# hasil git clone tanpa database dan tanpa menyentuh Overpass.
*.graphml

# Cache permintaan OSMnx, hanya berguna di mesin tempat skrip dijalankan
cache/

# ── Python ─────────────────────────────────────────────────────────────
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# ── Node / frontend ────────────────────────────────────────────────────
node_modules/
dist/
.vite/
*.local

# ── Sistem operasi & editor ────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# Tarikan mentah backscatter Sentinel-1 dari Earth Engine. Sekitar 300 MB
# dan bisa dibangun ulang dengan `python -m scripts.08_ekstrak_s1`, yang
# daftar ruas dan benih acaknya sudah dikunci di
# data/processed/ruas_sampel_latih.json sehingga hasilnya sama persis.
data/processed/s1_vv_ruas.jsonl
data/processed/s1_vv_contoh.jsonl
data/processed/s1_vv_ruas_radius*.jsonl

# Cache muka air terukur IOC: dibangun ulang oleh scripts/16, dan selama
# penarikan berjalan berkasnya ditulis berkala sehingga bisa tertangkap
# dalam keadaan setengah jadi.
data/referensi/muka_air_terukur_akuisisi.json
